# 统一换行符：Windows 上开发、Linux 上训练，shell 脚本必须是 LF。
* text=auto

*.py   text eol=lf
*.sh   text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.cfg  text eol=lf
*.svg  text eol=lf

# Windows 脚本保持 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二进制
*.pth binary
*.pt binary
*.safetensors binary
*.npz binary
*.npy binary
*.png binary
*.jpg binary
